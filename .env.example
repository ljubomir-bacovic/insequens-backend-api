# Copy to .env and fill in the values. Never commit .env.
# See docs/configuration.md for what each setting does.

ASPNETCORE_ENVIRONMENT=Production

# Semicolon-separated host names the API answers to.
AllowedHosts=

ConnectionStrings__InsequensConnection=

Jwt__Key=
Jwt__Issuer=
Jwt__Audience=

Frontend__BaseUrl=

Cors__AllowedOrigins__0=

# Only behind a reverse proxy: its IP address or CIDR range.
ReverseProxy__KnownProxies__0=
ReverseProxy__KnownNetworks__0=

Email__SmtpServer=
Email__Port=587
Email__UseTls=true
Email__Username=
Email__Password=
Email__From=
