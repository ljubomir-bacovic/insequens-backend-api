<Project Sdk="Microsoft.NET.Sdk">

  <!-- The HTTP contract shared with the web and mobile clients. It references nothing, so it can be packaged
       or used to generate clients without pulling in the server. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;Staging</Configurations>
  </PropertyGroup>

</Project>
